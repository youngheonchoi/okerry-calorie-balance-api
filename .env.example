# Server-side only. Do not prefix any of these variables with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Paste the full PEM contents directly into Vercel Environment Variables.
# Actual multiline PEM and literal \n separators are both supported.
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# Enable temporarily to call the deployed API from localhost:5173 / :5180.
# User verification is still required even for these local origins.
ALLOW_LOCAL_DEV_ORIGINS=false

# Server-only AI settings; never expose in the miniapp build.
OPENAI_API_KEY=
OPENAI_CALORIE_MODEL=gpt-6-luna
# Leave empty until issued: grants will remain disabled.
# Only in an isolated test deployment: ait-ad-test-rewarded-id
TOSS_REWARDED_AD_GROUP_ID=

# Dedicated rewarded ad group for CSV/prompt export (reward: export x 1).
# Public SDK group ID only; exposed by GET /api/ads. Leave empty until issued.
TOSS_EXPORT_REWARDED_AD_GROUP_ID=
